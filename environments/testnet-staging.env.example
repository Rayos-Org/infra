# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=staging
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────
# Use a dedicated Neon branch named `testnet-staging`
DATABASE_URL=postgresql://user:password@endpoint.neon.tech/neondb

# ── Redis ────────────────────────────────────────────────────────────────
# Use rediss:// with TLS for hosted Upstash Redis
REDIS_URL=rediss://default:password@endpoint.upstash.io:6379

# ── Stellar / Soroban (public testnet RPC) ────────────────────────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Deployed contract addresses (testnet) ─────────────────────────────────
FACTORY_CONTRACT_ID=CCCAMWJOF7IYTVCU7SR6HFTNH5XRMDMWPYN464NY5BCKUPMUM64RZ5CH
POLICY_CONTRACT_ID=CCDM3O2SXX3E24MCWLRK5YBVQHJCA4OQKJFF6KWCK6FHZS65DGMT6DOY

# ── WebAuthn (must match your staging domain) ─────────────────────────────
WEBAUTHN_RP_ID=relay-staging.rayos.dev
WEBAUTHN_ORIGIN=https://relay-staging.rayos.dev

# ── Fee sponsorship (Launchtube) ──────────────────────────────────────────
LAUNCHTUBE_API_KEY=

# ── Email notifications (Resend) ──────────────────────────────────────────
RESEND_API_KEY=