# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Database (use local Docker Postgres for dev; Neon branch for testnet-dev) ──
DATABASE_URL=postgresql://postgres:password@localhost:5432/relay_dev

# ── Redis (local Docker for dev; Upstash for testnet-dev) ─────────────────
REDIS_URL=redis://localhost:6379

# ── Stellar / Soroban (public testnet RPC — no API key needed) ────────────
SOROBAN_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Test SDF Network ; September 2015"

# ── Deployed contract addresses (testnet) ─────────────────────────────────
FACTORY_CONTRACT_ID=CDTQ3BPIMOPED4MFARAR3KM4IVEHSA4M4NRNUHXU3HW6E3NG4KCC7ESO
POLICY_CONTRACT_ID=CBIVUPL6T6GF4UFOVFOUVVORTQC5QB3LPXF27FHZWPLSMTZXLWHB7HZP

# ── WebAuthn (must match the frontend origin exactly) ─────────────────────
WEBAUTHN_RP_ID=localhost
WEBAUTHN_ORIGIN=http://localhost:3000

# ── Fee sponsorship (Launchtube) ──────────────────────────────────────────
# Get a testnet key from https://launchtube.xyz
LAUNCHTUBE_API_KEY=

# ── Email notifications (Resend) ──────────────────────────────────────────
# Get a free API key from https://resend.com
RESEND_API_KEY=