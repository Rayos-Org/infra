# ⚠️  MAINNET CONFIG — Never commit real values here.
# This file is a template only. Populate all secrets via your platform's
# secrets manager (Render dashboard, Doppler, GitHub Environments).
# A mainnet deployment requires a completed security review — see DEPLOYMENT-AND-OSS-GUIDE.md

# ── App ────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database ─────────────────────────────────────────────────────────────
# Use a dedicated Neon branch named `mainnet`
DATABASE_URL=

# ── Redis ────────────────────────────────────────────────────────────────
# Use rediss:// with TLS for hosted Upstash Redis
REDIS_URL=

# ── Stellar / Soroban (public mainnet RPC or self-hosted) ────────────────
SOROBAN_RPC_URL=https://soroban-mainnet.stellar.org
STELLAR_NETWORK_PASSPHRASE="Public Global Stellar Network ; September 2015"

# ── Deployed contract addresses (mainnet) ─────────────────────────────────
FACTORY_CONTRACT_ID=
POLICY_CONTRACT_ID=

# ── WebAuthn (must match your production domain) ──────────────────────────
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGIN=

# ── Fee sponsorship (Launchtube) ──────────────────────────────────────────
LAUNCHTUBE_API_KEY=

# ── Email notifications (Resend) ──────────────────────────────────────────
RESEND_API_KEY=